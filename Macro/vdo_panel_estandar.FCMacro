import sys
import FreeCAD as App

# Bootstrap
_vdo_macro_dir = App.getUserMacroDir(True)
if _vdo_macro_dir not in sys.path:
    sys.path.insert(0, _vdo_macro_dir)

from vdo_panel_core import crear_pieza

# Configuración física (orientación libre, sin semántica de mobiliario)
configuracion = {
    "nombre": "Panel_Base",
    "etiqueta": "Panel Estándar",
    "orientacion": "horizontal",
    "cantos": {
        "norte": "FX",
        "sur": "FX",
        "este": "RIG",
        "oeste": "FX",
    },
    "material_ref": "melamina_standar",
}

crear_pieza(configuracion)
